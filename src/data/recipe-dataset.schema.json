{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.recipes/schema/recipe-dataset.schema.json",
  "title": "Recipe Dataset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "datasetLanguage",
    "recipes"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "minLength": 1
    },
    "datasetLanguage": {
      "type": "string",
      "const": "en"
    },
    "recipes": {
      "type": "array",
      "minItems": 100,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/recipe"
      }
    }
  },
  "$defs": {
    "recipeType": {
      "type": "string",
      "enum": [
        "main",
        "appetizer",
        "dessert",
        "cocktail",
        "drink",
        "breakfast",
        "snack",
        "side",
        "sauce",
        "bread"
      ]
    },
    "allergen": {
      "type": "string",
      "enum": [
        "gluten",
        "milk",
        "egg",
        "peanut",
        "tree_nuts",
        "soy",
        "fish",
        "shellfish",
        "sesame",
        "mustard",
        "celery",
        "sulfites",
        "lupin",
        "mollusks"
      ]
    },
    "ingredient": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "amount",
        "unit",
        "notes"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "amount": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "instruction"
      ],
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "instruction": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "alt"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^(https?:\\/\\/|images\\/).+"
        },
        "alt": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "nutrition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kcalPerServing",
        "estimated"
      ],
      "properties": {
        "kcalPerServing": {
          "type": "integer",
          "minimum": 1
        },
        "estimated": {
          "type": "boolean"
        }
      }
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "type",
        "cuisine",
        "originCountry",
        "servings",
        "prepTimeMinutes",
        "cookTimeMinutes",
        "difficulty",
        "ingredients",
        "steps",
        "image",
        "nutrition",
        "allergens"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "$ref": "#/$defs/recipeType"
        },
        "cuisine": {
          "type": "string",
          "minLength": 1
        },
        "originCountry": {
          "type": "string",
          "minLength": 1
        },
        "servings": {
          "type": "integer",
          "minimum": 1
        },
        "prepTimeMinutes": {
          "type": "integer",
          "minimum": 1
        },
        "cookTimeMinutes": {
          "type": "integer",
          "minimum": 0
        },
        "difficulty": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "ingredients": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/ingredient"
          }
        },
        "steps": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "image": {
          "$ref": "#/$defs/image"
        },
        "nutrition": {
          "$ref": "#/$defs/nutrition"
        },
        "allergens": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/allergen"
          }
        }
      }
    }
  }
}