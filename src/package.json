{
  "name": "contoso-chef",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Contoso Chef - a recipe-sharing sample app built with Rayfin on Microsoft Fabric",
  "scripts": {
    "predev": "rayfin env --framework vite",
    "prebuild": "rayfin env --framework vite",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:fabric": "tsc -b && vite build --mode fabric",
    "preview": "vite preview",
    "rayfin:dev": "rayfin dev",
    "rayfin:dev:watch": "rayfin dev watch",
    "rayfin:dev:status": "rayfin dev status",
    "rayfin:dev:down": "rayfin dev --down",
    "rayfin:dev:purge": "rayfin dev --purge",
    "rayfin:storage": "rayfin dev storage apply",
    "rayfin:up": "rayfin up",
    "seed": "tsx scripts/seed.ts",
    "lint": "tsc -b --noEmit"
  },
  "dependencies": {
    "@microsoft/rayfin-auth-provider-fabric": "latest",
    "@microsoft/rayfin-client": "latest",
    "@microsoft/rayfin-core": "latest",
    "@microsoft/rayfin-storage": "latest",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0"
  },
  "devDependencies": {
    "@microsoft/rayfin-cli": "~1.18",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
