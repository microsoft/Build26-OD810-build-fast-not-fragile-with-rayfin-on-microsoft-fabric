{
  "name": "contoso-chef",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Contoso Chef - a recipe-sharing sample app built with Rayfin on Microsoft Fabric",
  "scripts": {
    "predev": "rayfin env --framework vite",
    "prebuild": "rayfin env --framework vite",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:fabric": "tsc -b && vite build --mode fabric",
    "preview": "vite preview",
    "rayfin:up": "rayfin up",
    "rayfin:up:status": "rayfin up status",
    "lint": "tsc -b --noEmit"
  },
  "dependencies": {
    "@microsoft/rayfin-auth-provider-fabric": "^1.32.0",
    "@microsoft/rayfin-client": "^1.32.0",
    "@microsoft/rayfin-core": "^1.32.0",
    "@microsoft/rayfin-storage": "^1.32.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.17.0"
  },
  "devDependencies": {
    "@microsoft/rayfin-cli": "~1.23.0",
    "@microsoft/rayfin-mcp": "^1.30.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^8.0.14"
  }
}
